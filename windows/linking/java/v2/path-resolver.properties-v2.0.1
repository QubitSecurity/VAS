# PLURA-Forensic LogParser relative-path resolver configuration.
# This file is loaded on every LogParser execution, so configuration changes do
# not require recompiling LogParser.java.

resolver.enabled=true
resolver.debug=false
resolver.preserveTrailingSlash=true

# Policy used when a base directory is missing or a path is invalid.
# KEEP_SILENT : Keep the original value without a warning.
# KEEP_WARN   : Keep the original value and print a warning to stderr.
# ERROR       : Throw an exception.
resolver.onMissingBase=KEEP_WARN
resolver.onInvalidPath=KEEP_WARN

# -----------------------------------------------------------------------------
# Grok field names that should be converted to absolute paths.
# -----------------------------------------------------------------------------
resolver.pathField.010=^targetFile[0-9]*$

# Enable additional fields here without changing the Java source.
# resolver.pathField.020=^sourceFile[0-9]*$
# resolver.pathField.030=^scriptFile[0-9]*$
# resolver.pathField.040=^libraryFile[0-9]*$
# resolver.pathField.050=^wordlistFile[0-9]*$
# resolver.pathField.060=^ruleFile[0-9]*$

# -----------------------------------------------------------------------------
# Rules that extract the base working directory from the input log.
# Rules are evaluated by key order; capture group 1 from the first match is used.
# In Java Properties files, write regular-expression backslashes twice: \\s
# -----------------------------------------------------------------------------

# pwd="/path with spaces", cwd="...", workdir="..."
resolver.baseRule.010=(?i)(?:^|[\\s,])(?:pwd|cwd|workdir|working_dir|workingDirectory)[ ]*=[ ]*"([^"]*)"

# pwd='/path with spaces'
resolver.baseRule.020=(?i)(?:^|[\\s,])(?:pwd|cwd|workdir|working_dir|workingDirectory)[ ]*=[ ]*'([^']*)'

# pwd=/home/qubit/filter-test
resolver.baseRule.030=(?i)(?:^|[\\s,])(?:pwd|cwd|workdir|working_dir|workingDirectory)[ ]*=[ ]*([^\\s,;}]+)

# JSON: "pwd": "/home/qubit/filter-test"
resolver.baseRule.040=(?i)"(?:pwd|cwd|workdir|working_dir|workingDirectory)"[ ]*:[ ]*"([^"]*)"

# auditd: type=CWD ... cwd="/home/qubit/filter-test"
resolver.baseRule.050=(?i)type=CWD.*cwd="([^"]*)"
resolver.baseRule.060=(?i)type=CWD.*cwd=([^\\s,;}]+)

# Add new field structures here without changing the Java source.
# resolver.baseRule.070=(?i)(?:^|[\\s,])directory[ ]*=[ ]*([^\\s,;}]+)
# resolver.baseRule.080=(?i)"currentWorkingDirectory"[ ]*:[ ]*"([^"]*)"

# -----------------------------------------------------------------------------
# Override rules for commands that change directory inside bash -c or sh -c.
# overrideRule entries take precedence over baseRule entries.
# Relative cd paths are resolved against the external base directory.
# -----------------------------------------------------------------------------
resolver.overrideRule.010=(?i)(?:^|[="';&|][ ]*)cd[ ]+(?:--[ ]+)?"([^"]+)"[ ]*(?:&&|;)
resolver.overrideRule.020=(?i)(?:^|[="';&|][ ]*)cd[ ]+(?:--[ ]+)?'([^']+)'[ ]*(?:&&|;)
resolver.overrideRule.030=(?i)(?:^|[="';&|][ ]*)cd[ ]+(?:--[ ]+)?([^;&|"' ]+)[ ]*(?:&&|;)

# -----------------------------------------------------------------------------
# Values that must remain unchanged and must not be joined with pwd/cwd.
# -----------------------------------------------------------------------------
resolver.skipRule.010=^-
resolver.skipRule.020=^~
resolver.skipRule.030=^\\$
resolver.skipRule.040=(?i)^[a-z][a-z0-9+.-]*://
resolver.skipRule.050=^[A-Za-z]:[\\\\/]
